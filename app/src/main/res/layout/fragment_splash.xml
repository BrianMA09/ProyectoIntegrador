<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fs"
    tools:context=".splash">

    <!-- Tarjeta principal del Splash centrada -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_splash"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        app:cardBackgroundColor="@color/c_base"
        app:cardCornerRadius="28dp"
        app:cardElevation="16dp"
        app:contentPaddingBottom="36dp"
        app:contentPaddingLeft="24dp"
        app:contentPaddingRight="24dp"
        app:contentPaddingTop="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Contenedor del Logo -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_logo"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp">

                <ImageView
                    android:id="@+id/img_logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/desc_logo_cacolearn"
                    android:scaleType="fitCenter"
                    android:src="@drawable/mi_logo2" />

            </androidx.cardview.widget.CardView>

            <!-- Título principal -->
            <TextView
                android:id="@+id/txt_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/afacadflux"
                android:letterSpacing="0.05"
                android:text="@string/app_name"
                android:textColor="@color/v_oscuro"
                android:textSize="32sp"
                android:textStyle="bold" />

            <!-- Subtítulo / Slogan -->
            <TextView
                android:id="@+id/txt_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.02"
                android:text="@string/splash_slogan"
                android:textColor="@color/v_medio"
                android:textSize="15sp"
                android:textStyle="italic" />

            <!-- Indicador de carga estilizado -->
            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="24dp"
                android:indeterminateTint="@color/v_claro" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Texto de versión al pie de página -->
    <TextView
        android:id="@+id/txt_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="@string/app_version"
        android:textColor="@color/v_oscuro"
        android:textSize="13sp"
        android:alpha="0.8" />

</FrameLayout>
