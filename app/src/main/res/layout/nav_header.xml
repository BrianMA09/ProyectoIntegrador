<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_drawer_panel"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="20dp"
    android:paddingRight="14dp"
    android:paddingBottom="10dp">

    <!-- HEADER CARD: User Welcome Info -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_drawer_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/drawer_card_header"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Artisan Cross-Stitch Pattern Banner -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:contentDescription="@string/drawer_open_menu"
                android:scaleType="fitXY"
                android:src="@drawable/ic_artisan_pattern" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingTop="10dp"
                android:paddingRight="12dp"
                android:paddingBottom="12dp">

                <!-- Profile Avatar Frame -->
                <androidx.cardview.widget.CardView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="#ECEEE4"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/img_drawer_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/desc_logo_cacolearn"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/mi_logo2" />
                </androidx.cardview.widget.CardView>

                <!-- User Info Text -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_drawer_welcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ptsans"
                        android:text="@string/drawer_welcome"
                        android:textColor="@color/drawer_text_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_drawer_username"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/ptsans"
                        android:text="@string/drawer_username"
                        android:textColor="@color/drawer_text_sub"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txt_drawer_useremail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ptsans"
                        android:text="@string/drawer_useremail"
                        android:textColor="@color/drawer_text_sub"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- CARD: Profile Actions (Dark Green) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_drawer_profile_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/drawer_green_dark"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <!-- Bird Artisan Icon -->
            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/drawer_admin_profile"
                android:src="@drawable/ic_bird_artisan" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btn_drawer_admin_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/ptsans"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingTop="2dp"
                    android:paddingBottom="6dp"
                    android:text="@string/drawer_admin_profile"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_drawer_change_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/ptsans"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingTop="6dp"
                    android:paddingBottom="2dp"
                    android:text="@string/drawer_change_password"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
