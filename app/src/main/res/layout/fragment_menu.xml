<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".menu">

    <!-- MAIN HOME CONTENT LAYOUT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/fondo"
        android:orientation="vertical">

        <!-- Toolbar for Drawer Toggle -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/v_oscuro"
            android:elevation="4dp"
            app:title="Hats'i, Mario"
            app:titleTextColor="@color/white" />

        <!-- Home Content Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/c_base"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="16dp"
                    android:paddingTop="16dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="24dp">

                    <!-- SECTION 1: PROGRESO CARD -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_progress_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:fontFamily="@font/ptsans"
                            android:text="@string/home_progress_title"
                            android:textColor="@color/v_oscuro"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <!-- 3 STAT CARDS ROW -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <!-- Stat 1: Racha -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="100dp"
                                android:layout_margin="4dp"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/c_base"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="2dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="6dp">

                                    <ImageView
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:contentDescription="@string/home_stat_streak"
                                        android:src="@drawable/ic_stat_fire" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="6dp"
                                        android:fontFamily="@font/ptsans"
                                        android:text="@string/home_stat_streak"
                                        android:textColor="#2E7D32"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <!-- Stat 2: Puntos (XP) -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="100dp"
                                android:layout_margin="4dp"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/c_base"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="2dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="6dp">

                                    <ImageView
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:contentDescription="@string/home_stat_xp"
                                        android:src="@drawable/estrella_icono" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="6dp"
                                        android:fontFamily="@font/ptsans"
                                        android:text="@string/home_stat_xp"
                                        android:textColor="#B78103"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <!-- Stat 3: Liga -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="100dp"
                                android:layout_margin="4dp"
                                android:layout_weight="1"
                                app:cardBackgroundColor="@color/c_base"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="2dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="6dp">

                                    <ImageView
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:contentDescription="@string/home_stat_league"
                                        android:src="@drawable/ic_stat_badge" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="6dp"
                                        android:fontFamily="@font/ptsans"
                                        android:text="@string/home_stat_league"
                                        android:textAlignment="center"
                                        android:textColor="#8D5B18"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>

                        <!-- UNIT TITLE & PROGRESS BAR -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/ptsans"
                            android:text="@string/home_unit_title"
                            android:textColor="@color/v_oscuro"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ProgressBar
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:layout_marginLeft="16dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginRight="16dp"
                            android:max="100"
                            android:progress="70"
                            android:progressTint="@color/v_oscuro" />
                    </LinearLayout>

                    <!-- SECTION 2: CONTINÚA LECCIÓN CARD -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/home_card_continue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="3dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="14dp">

                            <!-- Book / Lesson Icon Container -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                app:cardBackgroundColor="#C2D8BA"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@string/home_continue_title"
                                    android:src="@drawable/ic_lesson_book" />
                            </androidx.cardview.widget.CardView>

                            <!-- Lesson Info Text -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/ptsans"
                                    android:text="@string/home_continue_title"
                                    android:textColor="@color/v_oscuro"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/ptsans"
                                    android:text="@string/home_continue_sub"
                                    android:textColor="#55684D"
                                    android:textSize="14sp" />
                            </LinearLayout>

                            <!-- Button "Ir" -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/btn_home_ir"
                                android:layout_width="52dp"
                                android:layout_height="42dp"
                                app:cardBackgroundColor="@color/v_oscuro"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="2dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:fontFamily="@font/ptsans"
                                    android:text="@string/home_btn_ir"
                                    android:textColor="@color/white"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- SECTION 3: PALABRA DEL DÍA CARD -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_word_card"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ptsans"
                            android:letterSpacing="0.06"
                            android:text="@string/home_word_title"
                            android:textColor="#E5C158"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/ptsans"
                            android:text="@string/home_word_content"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold|italic" />
                    </LinearLayout>

                    <!-- SECTION 4: ¿SABÍAS QUE? CARD -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_sabias_que"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/ptsans"
                                android:text="@string/home_did_you_know_title"
                                android:textColor="@color/v_oscuro"
                                android:textSize="20sp"
                                android:textStyle="bold|italic" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/ptsans"
                                android:lineSpacingExtra="2dp"
                                android:text="@string/home_did_you_know_desc"
                                android:textColor="#2A3F24"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Illustration / Characters Circle Frame -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="85dp"
                            android:layout_height="85dp"
                            android:layout_marginStart="12dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="42dp"
                            app:cardElevation="2dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/home_did_you_know_title"
                                android:padding="6dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/mi_logo2" />
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <!-- SECTION 5: OBTEN YA CACOLEARN+ BANNER -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_caco_plus"
                        android:paddingStart="20dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="18dp">

                        <TextView
                            android:id="@+id/txt_caco_plus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@id/img_caco_mascot"
                            android:fontFamily="@font/ptsans"
                            android:lineSpacingExtra="4dp"
                            android:text="@string/home_caco_plus"
                            android:textColor="#A8F04B"
                            android:textSize="22sp"
                            android:textStyle="bold|italic" />

                        <!-- Mascot Racoon/Coati Graphic -->
                        <ImageView
                            android:id="@+id/img_caco_mascot"
                            android:layout_width="95dp"
                            android:layout_height="95dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:contentDescription="@string/desc_logo_cacolearn"
                            android:scaleType="fitCenter"
                            android:src="@drawable/mi_logo2" />
                    </RelativeLayout>

                </LinearLayout>
            </ScrollView>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- NAVIGATION VIEW WITH MENU XML RESOURCE -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_drawer_panel"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/v_oscuro"
        app:itemTextColor="@color/drawer_text_dark"
        app:menu="@menu/menu_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
