<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".miregion">

    <!-- MAIN CONTENT LAYOUT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/fondo"
        android:orientation="vertical">

        <!-- Header Banner with Title Pill -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="@drawable/bg_drawer_green_pattern">

            <!-- Hamburger Button -->
            <ImageView
                android:id="@+id/btn_open_drawer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/drawer_open_menu"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_menu_hamburger" />

            <!-- Center Title Pill "Mi región" -->
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:cardBackgroundColor="@color/c_arena"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ptsans"
                    android:paddingStart="28dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="8dp"
                    android:text="@string/region_title"
                    android:textColor="@color/v_oscuro"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

        </FrameLayout>

        <!-- Main Content List Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/c_base"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="20dp">

                    <!-- ITEM 1: Otomí -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_region_otomi"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginBottom="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/drawer_item_bg"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="3dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:contentDescription="@string/region_otomi"
                                android:src="@drawable/ic_region_otomi" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/ptsans"
                                android:text="@string/region_otomi"
                                android:textColor="@color/drawer_text_dark"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- ITEM 2: Origen -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_region_origen"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginBottom="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/drawer_item_bg"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="3dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:contentDescription="@string/region_origen"
                                android:src="@drawable/ic_region_origen" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/ptsans"
                                android:text="@string/region_origen"
                                android:textColor="@color/drawer_text_dark"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- ITEM 3: Cultura -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_region_cultura"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginBottom="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/drawer_item_bg"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="3dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:contentDescription="@string/region_cultura"
                                android:src="@drawable/ic_region_cultura" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/ptsans"
                                android:text="@string/region_cultura"
                                android:textColor="@color/drawer_text_dark"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- ITEM 4: Tradiciones -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_region_tradiciones"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginBottom="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/drawer_item_bg"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="3dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:contentDescription="@string/region_tradiciones"
                                android:src="@drawable/ic_region_tradiciones" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/ptsans"
                                android:text="@string/region_tradiciones"
                                android:textColor="@color/drawer_text_dark"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- ITEM 5: Flora y Fauna -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_region_florafauna"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginBottom="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/drawer_item_bg"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="3dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:contentDescription="@string/region_florafauna"
                                android:src="@drawable/ic_region_florafauna" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/ptsans"
                                android:text="@string/region_florafauna"
                                android:textColor="@color/drawer_text_dark"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- ITEM 6: Galería -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_region_galeria"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginBottom="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/drawer_item_bg"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="3dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:contentDescription="@string/region_galeria"
                                android:src="@drawable/ic_region_galeria" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/ptsans"
                                android:text="@string/region_galeria"
                                android:textColor="@color/drawer_text_dark"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </ScrollView>
        </androidx.cardview.widget.CardView>

        <!-- Bottom Footer Bar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@color/v_oscuro" />

    </LinearLayout>

    <!-- NAVIGATION VIEW WITH MENU XML RESOURCE -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_drawer_panel"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/v_oscuro"
        app:itemTextColor="@color/drawer_text_dark"
        app:menu="@menu/menu_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
