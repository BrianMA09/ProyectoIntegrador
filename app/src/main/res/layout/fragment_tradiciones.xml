<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".tradiciones">

    <!-- MAIN CONTENT LAYOUT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/fondo"
        android:orientation="vertical">

        <!-- Header Banner with Back Button and Title -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="@drawable/bg_drawer_green_pattern">

            <!-- Back Button -->
            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/region_tradiciones"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_back_arrow" />

            <!-- Title Pill -->
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:cardBackgroundColor="@color/c_arena"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ptsans"
                    android:paddingStart="28dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="8dp"
                    android:text="@string/region_tradiciones"
                    android:textColor="@color/v_oscuro"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- Main Content Area -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- CATEGORY 1: FIESTAS Y RITUALES SAGRADOS -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_trad_fiestas"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:layout_marginBottom="18dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/v_oscuro"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ptsans"
                            android:text="@string/trad_cat_1_title"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/ptsans"
                            android:text="@string/trad_cat_1_sub"
                            android:textColor="#C5D8B8"
                            android:textSize="13sp"
                            android:textStyle="italic" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- CATEGORY 2: GASTRONOMÍA Y PULQUE -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_trad_gastronomia"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:layout_marginBottom="18dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/v_oscuro"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ptsans"
                            android:text="@string/trad_cat_2_title"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/ptsans"
                            android:text="@string/trad_cat_2_sub"
                            android:textColor="#C5D8B8"
                            android:textSize="13sp"
                            android:textStyle="italic" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- CATEGORY 3: ARTE POPULAR Y VESTIMENTA -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_trad_arte"
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:layout_marginBottom="18dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/v_oscuro"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/ptsans"
                            android:text="@string/trad_cat_3_title"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/ptsans"
                            android:text="@string/trad_cat_3_sub"
                            android:textColor="#C5D8B8"
                            android:textSize="13sp"
                            android:textStyle="italic" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>

        <!-- Footer Bar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/v_oscuro" />

    </LinearLayout>

    <!-- NAVIGATION VIEW -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_drawer_panel"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/v_oscuro"
        app:itemTextColor="@color/drawer_text_dark"
        app:menu="@menu/menu_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
