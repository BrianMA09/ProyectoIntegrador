<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo"
    android:orientation="vertical"
    tools:context=".trad_arte">

    <!-- Header Banner with Back Button and Title -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@drawable/bg_drawer_green_pattern">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/trad_cat_3_title"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_back_arrow" />

        <!-- Title Pill -->
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/c_arena"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ptsans"
                android:paddingStart="22dp"
                android:paddingTop="8dp"
                android:paddingEnd="22dp"
                android:paddingBottom="8dp"
                android:text="@string/trad_cat_3_title"
                android:textColor="@color/v_oscuro"
                android:textSize="20sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!-- Main Content Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- MAIN ARTE CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#DFE8D7"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ptsans"
                        android:text="@string/trad_cat_3_title"
                        android:textColor="@color/v_oscuro"
                        android:textSize="20sp"
                        android:textStyle="bold|italic" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/ptsans"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/cultura_t6_body"
                        android:textColor="#2A3F24"
                        android:textSize="13sp" />

                    <!-- IMAGE PLACEHOLDER FOR ARTE POPULAR -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="16dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_image_placeholder">

                            <ImageView
                                android:id="@+id/img_arte_1"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/trad_cat_3_title"
                                android:scaleType="centerCrop" />

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/trad_cat_3_title"
                                android:src="@drawable/ic_photo_placeholder" />
                        </FrameLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#DFE8D7"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ptsans"
                        android:text="@string/trad_cat_3_title"
                        android:textColor="@color/v_oscuro"
                        android:textSize="20sp"
                        android:textStyle="bold|italic" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/ptsans"
                        android:lineSpacingExtra="3dp"
                        android:text="Atavío de la Mujer Hñähñu:
Chincuete (Enredo): Falda larga de lana o manta. En el uso cotidiano prevalece el color negro con rayas azules, blancas o moradas.
Blusa: De manta o popelina blanca con delicados bordados a mano en cuello y mangas representando flores, animales o figuras geométricas.
Quexquémitl: Prenda abierta de algodón o lana. En la región tiene un uso ceremonial único: se utiliza para cubrise la cabeza o para vestir a las imágenes en procesión.
Accesorios: Faja bordada para sujetar la falda, rebozo, cabello trenzado con cordones de colores y joyería en cuello y orejas.
Atavío del Hombre Hñähñu:
Camisa y Calzón: Elaborados en manta blanca. La camisa lleva bordados artesanales en el pecho y los puños para su uso en festividades.
Complementos: Gabán o sarape de lana para el frío, sombrero de palma tejido en la región, faja tejida y huaraches de cuero.
"
                        android:textColor="#2A3F24"
                        android:textSize="13sp" />



                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Footer Bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/v_oscuro" />

</LinearLayout>
