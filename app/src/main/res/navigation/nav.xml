<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav"
    app:startDestination="@id/splash">

    <fragment
        android:id="@+id/splash"
        android:name="com.itsoeh.mabrian.cacolearn.splash"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/login"
            app:popUpTo="@id/splash"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/login"
        android:name="com.itsoeh.mabrian.cacolearn.login"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_autoregistro"
            app:destination="@id/autoregistro"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_login_to_menu"
            app:destination="@id/menu"
            app:popUpTo="@id/login"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/autoregistro"
        android:name="com.itsoeh.mabrian.cacolearn.autoregistro"
        android:label="Autoregistro"
        tools:layout="@layout/fragment_autoregistro">
        <action
            android:id="@+id/action_autoregistro_to_login"
            app:destination="@id/login"
            app:popUpTo="@id/login"
            app:popUpToInclusive="true"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left" />
    </fragment>

    <fragment
        android:id="@+id/menu"
        android:name="com.itsoeh.mabrian.cacolearn.menu"
        android:label="Menu"
        tools:layout="@layout/fragment_menu" >
        <action
            android:id="@+id/action_menu_to_menuinfo"
            app:destination="@id/menuinfo"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_menu_to_login"
            app:destination="@id/login"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left" />
        <action
            android:id="@+id/action_menu_to_miregion"
            app:destination="@id/miregion"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/miregion"
        android:name="com.itsoeh.mabrian.cacolearn.miregion"
        android:label="Mi región"
        tools:layout="@layout/fragment_miregion">
        <action
            android:id="@+id/action_miregion_to_menu"
            app:destination="@id/menu"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left" />
        <action
            android:id="@+id/action_miregion_to_otomi"
            app:destination="@id/otomi"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_miregion_to_origen"
            app:destination="@id/origen"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_miregion_to_cultura"
            app:destination="@id/cultura"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_miregion_to_tradiciones"
            app:destination="@id/tradiciones"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_miregion_to_florafauna"
            app:destination="@id/florafauna"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_miregion_to_galeria"
            app:destination="@id/galeria"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- Mi Región Sub-Sections -->
    <fragment
        android:id="@+id/otomi"
        android:name="com.itsoeh.mabrian.cacolearn.otomi"
        android:label="Otomí"
        tools:layout="@layout/fragment_otomi" />

    <fragment
        android:id="@+id/origen"
        android:name="com.itsoeh.mabrian.cacolearn.origen"
        android:label="Origen"
        tools:layout="@layout/fragment_origen" />

    <fragment
        android:id="@+id/cultura"
        android:name="com.itsoeh.mabrian.cacolearn.cultura"
        android:label="Cultura"
        tools:layout="@layout/fragment_cultura" />

    <fragment
        android:id="@+id/tradiciones"
        android:name="com.itsoeh.mabrian.cacolearn.tradiciones"
        android:label="Tradiciones"
        tools:layout="@layout/fragment_tradiciones">
        <action
            android:id="@+id/action_tradiciones_to_trad_fiestas"
            app:destination="@id/trad_fiestas"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_tradiciones_to_trad_gastronomia"
            app:destination="@id/trad_gastronomia"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_tradiciones_to_trad_arte"
            app:destination="@id/trad_arte"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- Tradiciones Sub-Sections -->
    <fragment
        android:id="@+id/trad_fiestas"
        android:name="com.itsoeh.mabrian.cacolearn.trad_fiestas"
        android:label="Fiestas y Rituales Sagrados"
        tools:layout="@layout/fragment_trad_fiestas" />

    <fragment
        android:id="@+id/trad_gastronomia"
        android:name="com.itsoeh.mabrian.cacolearn.trad_gastronomia"
        android:label="Gastronomía y Pulque"
        tools:layout="@layout/fragment_trad_gastronomia" />

    <fragment
        android:id="@+id/trad_arte"
        android:name="com.itsoeh.mabrian.cacolearn.trad_arte"
        android:label="Arte Popular y Vestimenta"
        tools:layout="@layout/fragment_trad_arte" />

    <fragment
        android:id="@+id/florafauna"
        android:name="com.itsoeh.mabrian.cacolearn.florafauna"
        android:label="Flora y Fauna"
        tools:layout="@layout/fragment_florafauna" />

    <fragment
        android:id="@+id/galeria"
        android:name="com.itsoeh.mabrian.cacolearn.galeria"
        android:label="Galería"
        tools:layout="@layout/fragment_galeria" />

    <fragment
        android:id="@+id/menuinfo"
        android:name="com.itsoeh.mabrian.cacolearn.menuinfo"
        android:label="fragment_menuinfo"
        tools:layout="@layout/fragment_menuinfo" >
        <action
            android:id="@+id/action_menuinfo_to_menu"
            app:destination="@id/menu"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left" />
    </fragment>

</navigation>